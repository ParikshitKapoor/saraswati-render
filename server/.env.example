# Saraswati Motors — Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas connection string or left empty for In-Memory DB in dev)
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Client Origin URL for CORS
CLIENT_URL=http://localhost:5173

# Registered Admin Details (Password is never hardcoded; set via SMS OTP on first login)
ADMIN_USERNAME=admin
ADMIN_PHONE=+91 98117 98761

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS Gateway Configuration (Traccar SMS Gateway / Android SMS Gateway API)
SMS_GATEWAY_URL=https://traccar.org
SMS_GATEWAY_TOKEN=your_traccar_gateway_token_here

# Optional Legacy SMS Gateway Configurations (e.g., Fast2SMS / Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
